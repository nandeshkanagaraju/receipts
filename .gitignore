# ---- generated data artifacts (rebuilt by `make data`, never committed) ----
data/
*.duckdb
*.duckdb.wal
*.parquet

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- web (SDD §22: built into static files served by the API) ----
node_modules/
web/dist/

# ---- secrets (SDD §26: secrets come only from the environment) ----
.env
.env.*
!.env.example

# ---- OS noise ----
.DS_Store

# ---- authoring scaffolding, never part of the artifact ----
# _reports/
# Counts-only CI marker (scripts/freeze_gen.py). Never holds sealed content,
# but it is build output and belongs to a run, not to the repository.
_ci/ holds end-of-module reports written for the reader, not the build.
# _review/ holds question drafts under review; deleted at questions-frozen.
_reports/
eval/questions/_review/

# ---- deliberately NOT ignored, listed here so nobody adds them later ----
# eval/recordings/  model responses are committed: replay must work offline (D16, ADR-005)
# Sealed holdout truth. NEVER tracked: this repository is public and these files
# are the answers to the blind set. Only their SHA-256 hashes are recorded, in
# docs/FREEZE_MANIFEST.json (ADR-012). The line that used to sit here said the
# opposite - "sealed holdout truth is committed" - a leftover from the SDD section 3
# skeleton that outlived the ruling reversing it, and two commits duly pushed the
# sealed files to a public remote.
eval/sealed/*
!eval/sealed/.gitkeep
# eval/results/     committed reports; CI asserts byte-identical output (SDD §28)
# truth/            constructed ground truth, recorded at generation time (D11)

# ---- generator output (rebuilt by `make data`) ----
truth/
