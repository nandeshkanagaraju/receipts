    "/api/v1/catalog/run": {
      "post": {
        "description": "J7: answers with no model in the path at all.\n\nThis route exists so that \"the model is down\" and \"the product is down\"\nare different sentences. It runs validate -> compile -> guard -> execute\non a plan the caller hand-built; nothing here can reach an LLM.",
        "operationId": "catalog_run_api_v1_catalog_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogRunBody"
              }
            }
          },
          "required": true
