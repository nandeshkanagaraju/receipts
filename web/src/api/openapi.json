            },
            "description": "Validation Error"
          }
        },
        "summary": "Catalog Run"
      }
    },
    "/api/v1/clarify": {
      "post": {
        "description": "The asker's choice, applied to the plan (M17.1).\n\nThis route used to re-ask `body.option_id` as though it were the question\nand mark the ambiguity answered. That let the DEFAULT win: both options of\na two-option clarification returned the same metric and the same number,\nVERIFIED, with a receipt. The choice is now carried as an id and applied\nby the orchestrator to the plan the gate was asking about.",
        "operationId": "clarify_api_v1_clarify_post",
        "parameters": [
          {
            "in": "query",
            "name": "stream",
            "required": false,
            "schema": {
              "default": true,
              "title": "Stream",
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClarifyBody"
