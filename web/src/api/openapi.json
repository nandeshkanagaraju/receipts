        ],
        "title": "AskBody",
        "type": "object"
      },
      "CatalogRunBody": {
        "description": "A hand-built plan, for catalog mode: no model anywhere in this path.",
        "properties": {
          "dimensions": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Dimensions",
            "type": "array"
          },
          "grain": {
            "default": "NONE",
            "title": "Grain",
            "type": "string"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          },
          "metric": {
            "title": "Metric",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "window": {
            "additionalProperties": true,
            "default": {},
            "title": "Window",
            "type": "object"
          }
        },
        "required": [
          "metric"
        ],
        "title": "CatalogRunBody",
        "type": "object"
      },
      "ClarifyBody": {
        "description": "Answering a clarification.\n\n`question` is the ORIGINAL question, resent. The API keeps no session state,\nso the alternative is storing the pending clarification server-side; resending\nthe asker's own sentence is the smaller change and keeps the route stateless.\n`option_id` is matched against the options the gate derives on this run, so\nnothing the client sends can become a plan change of its own.",
        "properties": {
          "clarification_id": {
            "title": "Clarification Id",
            "type": "string"
          },
          "option_id": {
            "title": "Option Id",
            "type": "string"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "clarification_id",
          "option_id",
          "question"
        ],
        "title": "ClarifyBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginBody": {
        "properties": {
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "title": "LoginBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WhyBody": {
        "properties": {
          "receipt_id": {
            "title": "Receipt Id",
            "type": "string"
          }
        },
        "required": [
          "receipt_id"
        ],
        "title": "WhyBody",
        "type": "object"
      }
    }
