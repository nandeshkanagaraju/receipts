{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./eval/sealed/**)",
      "Bash(cat ./.env*)",
      "Bash(cat .env*)",
      "Bash(cat eval/sealed/*)",
      "Bash(cat ./eval/sealed/*)",
      "Bash(head eval/sealed/*)",
      "Bash(tail eval/sealed/*)",
      "Bash(less eval/sealed/*)",
      "Bash(sed eval/sealed/*)",
      "Bash(sed ./eval/sealed/*)",
      "Bash(awk eval/sealed/*)",
      "Bash(awk ./eval/sealed/*)",
      "Bash(grep eval/sealed/*)",
      "Bash(grep ./eval/sealed/*)",
      "Bash(rg eval/sealed/*)",
      "Bash(rg ./eval/sealed/*)",
      "Bash(nl eval/sealed/*)",
      "Bash(nl ./eval/sealed/*)",
      "Bash(strings eval/sealed/*)",
      "Bash(strings ./eval/sealed/*)",
      "Bash(xxd eval/sealed/*)",
      "Bash(xxd ./eval/sealed/*)",
      "Bash(od eval/sealed/*)",
      "Bash(od ./eval/sealed/*)",
      "Bash(more eval/sealed/*)",
      "Bash(more ./eval/sealed/*)",
      "Bash(bat eval/sealed/*)",
      "Bash(bat ./eval/sealed/*)",
      "Bash(cp eval/sealed/*)",
      "Bash(cp ./eval/sealed/*)",
      "Read(./eval/reference_sql/HO-*)",
      "Read(eval/reference_sql/HO-*)",
      "Bash(cat eval/reference_sql/HO-*)",
      "Bash(cat ./eval/reference_sql/HO-*)",
      "Bash(head eval/reference_sql/HO-*)",
      "Bash(head ./eval/reference_sql/HO-*)",
      "Bash(tail eval/reference_sql/HO-*)",
      "Bash(tail ./eval/reference_sql/HO-*)",
      "Bash(less eval/reference_sql/HO-*)",
      "Bash(less ./eval/reference_sql/HO-*)",
      "Bash(more eval/reference_sql/HO-*)",
      "Bash(more ./eval/reference_sql/HO-*)",
      "Bash(sed eval/reference_sql/HO-*)",
      "Bash(sed ./eval/reference_sql/HO-*)",
      "Bash(awk eval/reference_sql/HO-*)",
      "Bash(awk ./eval/reference_sql/HO-*)",
      "Bash(grep eval/reference_sql/HO-*)",
      "Bash(grep ./eval/reference_sql/HO-*)",
      "Bash(rg eval/reference_sql/HO-*)",
      "Bash(rg ./eval/reference_sql/HO-*)",
      "Bash(nl eval/reference_sql/HO-*)",
      "Bash(nl ./eval/reference_sql/HO-*)",
      "Bash(strings eval/reference_sql/HO-*)",
      "Bash(strings ./eval/reference_sql/HO-*)",
      "Bash(xxd eval/reference_sql/HO-*)",
      "Bash(xxd ./eval/reference_sql/HO-*)",
      "Bash(od eval/reference_sql/HO-*)",
      "Bash(od ./eval/reference_sql/HO-*)",
      "Bash(bat eval/reference_sql/HO-*)",
      "Bash(bat ./eval/reference_sql/HO-*)",
      "Bash(cp eval/reference_sql/HO-*)",
      "Bash(cp ./eval/reference_sql/HO-*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/deny_sealed_history.py"
          }
        ]
      }
    ]
  },
  "_comment": "Isolated reference run only (docs/ISOLATED_REFERENCE_RUN.md). This is main's settings.json with the holdout deny entries removed and nothing else changed: every .env and eval/sealed entry is intact, because no session ever needs those. Copy over the worktree's .claude/settings.json, then `git update-index --assume-unchanged .claude/settings.json` so the relaxation cannot be staged."
}
